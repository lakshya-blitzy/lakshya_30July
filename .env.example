# Node.js Security Configuration Template
# Copy this file to .env and configure appropriate values for your environment

# Server Configuration
PORT=3000
HTTPS_PORT=3443
NODE_ENV=development

# Rate Limiting Configuration (per Summary of Changes Section 0.6.3)
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=1000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration - Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# SSL/TLS Certificate Paths for HTTPS
SSL_CERT_PATH=./certs/server.crt
SSL_KEY_PATH=./certs/server.key

# JWT Configuration (if implementing authentication)
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production
JWT_EXPIRES_IN=24h

# Trust Proxy Settings (for production behind load balancer)
TRUST_PROXY=false

# Security Feature Toggles
ENABLE_HTTPS_REDIRECT=true
ENABLE_SECURITY_LOGGING=true
ENABLE_CORS_CREDENTIALS=true

# Content Security Policy Configuration
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self'
CSP_STYLE_SRC='self' 'unsafe-inline'
CSP_IMG_SRC='self' data: https:

# Production Security Settings
# Set these in production environment
# HELMET_HSTS_MAX_AGE=31536000
# HELMET_HSTS_INCLUDE_SUBDOMAINS=true
# HELMET_HSTS_PRELOAD=true

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# Error Handling Configuration
EXPOSE_STACK_TRACES=false
GENERIC_ERROR_MESSAGE=An error occurred while processing your request

# Request Size Limits
MAX_REQUEST_SIZE=10mb
MAX_JSON_SIZE=10mb
MAX_URL_ENCODED_SIZE=10mb