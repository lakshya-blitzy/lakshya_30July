# ============================================================================
# Node.js Security Configuration Template
# ============================================================================
# This file provides secure defaults and configuration guidance for 
# development, staging, and production environments.
# Copy this file to .env and customize values for your environment.
# NEVER commit .env files to version control.

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Basic server settings
NODE_ENV=development
PORT=3000
HOST=localhost

# Framework Configuration
# Set to true to use Express.js framework, false for basic HTTP server
USE_EXPRESS=true

# Server Mode Configuration
USE_EXPRESS=true

# HTTPS Configuration (required for production)
HTTPS_PORT=3443
HTTPS_ENABLED=false

# SSL/TLS Certificate paths (required when HTTPS_ENABLED=true)
# For development: Use self-signed certificates
# For production: Use CA-issued certificates
SSL_CERT_PATH=./certs/server.crt
SSL_KEY_PATH=./certs/server.key
SSL_CA_PATH=./certs/ca.crt

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Trust Proxy Settings (enable when behind reverse proxy/load balancer)
TRUST_PROXY=false

# Security Headers (managed by Helmet.js)
DISABLE_X_POWERED_BY=true
HIDE_SERVER_HEADER=true

# Content Security Policy (CSP) - comprehensive security directives
CSP_ENABLED=true
CSP_DEFAULT_SRC="'self'"
CSP_SCRIPT_SRC="'self' 'unsafe-inline' 'unsafe-eval'"
CSP_STYLE_SRC="'self' 'unsafe-inline' https://fonts.googleapis.com"
CSP_IMG_SRC="'self' data: https: blob:"
CSP_FONT_SRC="'self' https://fonts.gstatic.com"
CSP_CONNECT_SRC="'self' https:"
CSP_MEDIA_SRC="'self'"
CSP_OBJECT_SRC="'none'"
CSP_CHILD_SRC="'self'"
CSP_FRAME_SRC="'self'"
CSP_WORKER_SRC="'self'"
CSP_MANIFEST_SRC="'self'"
CSP_BASE_URI="'self'"
CSP_FORM_ACTION="'self'"
CSP_FRAME_ANCESTORS="'none'"
CSP_UPGRADE_INSECURE_REQUESTS=true
CSP_BLOCK_ALL_MIXED_CONTENT=true

# HTTP Strict Transport Security (HSTS)
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# X-Frame-Options (clickjacking protection)
FRAME_OPTIONS=SAMEORIGIN

# Referrer Policy (control referrer information)
REFERRER_POLICY=strict-origin-when-cross-origin

# X-Content-Type-Options (prevent MIME type sniffing)
CONTENT_TYPE_OPTIONS=nosniff

# X-DNS-Prefetch-Control
DNS_PREFETCH_CONTROL=off

# X-Download-Options
DOWNLOAD_OPTIONS=noopen

# X-Permitted-Cross-Domain-Policies
PERMITTED_CROSS_DOMAIN_POLICIES=none

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================

# Enable/disable rate limiting
RATE_LIMIT_ENABLED=true

# Global rate limiting (protects against DDoS attacks)
# 15 minutes = 900000 milliseconds
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX_REQUESTS=1000
GLOBAL_RATE_LIMIT_MESSAGE="Too many requests from this IP, please try again later"
GLOBAL_RATE_LIMIT_SKIP_SUCCESS_REQUESTS=false

# API endpoint rate limiting (more restrictive for API calls)
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=100
API_RATE_LIMIT_MESSAGE="API rate limit exceeded, please try again in a minute"
API_RATE_LIMIT_HEADERS=true

# Authentication rate limiting (protect login/auth endpoints)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5
AUTH_RATE_LIMIT_MESSAGE="Too many authentication attempts, please try again later"
AUTH_RATE_LIMIT_SKIP_FAILED_REQUESTS=false

# Health check rate limiting (for monitoring systems)
HEALTH_RATE_LIMIT_WINDOW_MS=60000
HEALTH_RATE_LIMIT_MAX_REQUESTS=60
HEALTH_RATE_LIMIT_MESSAGE="Health check rate limit exceeded"

# Legacy support (maintain backwards compatibility)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ============================================================================
# CORS (Cross-Origin Resource Sharing) CONFIGURATION
# ============================================================================

# Enable CORS
CORS_ENABLED=true

# Allowed origins (comma-separated list)
# Development example:
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
# Production example:
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com

# CORS credentials support
CORS_CREDENTIALS=true

# Allowed methods
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS

# Allowed headers
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,Origin,X-API-Key

# Exposed headers
CORS_EXPOSED_HEADERS=Content-Length,Date,X-API-Version

# Preflight cache duration (24 hours = 86400 seconds)
CORS_MAX_AGE=86400

# ============================================================================
# AUTHENTICATION & SESSION CONFIGURATION
# ============================================================================

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-at-least-256-bits-long-change-in-production
JWT_EXPIRATION=1h
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production
JWT_REFRESH_EXPIRATION=7d

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-in-production
SESSION_TIMEOUT=3600000
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# bcrypt password hashing rounds (12 recommended for production)
BCRYPT_ROUNDS=12

# ============================================================================
# INPUT VALIDATION & SANITIZATION
# ============================================================================

# Input validation settings
VALIDATION_ENABLED=true
SANITIZATION_ENABLED=true

# Maximum request body size (prevents DoS attacks)
MAX_REQUEST_SIZE=10mb

# Maximum URL length
MAX_URL_LENGTH=2048

# Maximum header size
MAX_HEADER_SIZE=8192

# ============================================================================
# LOGGING & MONITORING CONFIGURATION (Winston)
# ============================================================================

# Winston logging configuration
# Logging levels: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info
LOG_LEVEL_CONSOLE=info
LOG_LEVEL_FILE=warn

# Log sensitive data (should be false in production)
LOG_SENSITIVE_DATA=false
LOG_STACK_TRACES=true

# Winston log directories and file paths
LOG_DIR=./logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
LOG_DATE_PATTERN=YYYY-MM-DD

# Winston log file configurations
ERROR_LOG_FILE=error.log
ERROR_LOG_LEVEL=error
COMBINED_LOG_FILE=combined.log
ACCESS_LOG_FILE=access.log
DEBUG_LOG_FILE=debug.log

# Winston transport configuration
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_COLORIZE=true
LOG_TIMESTAMP=true
LOG_JSON_FORMAT=false

# Request logging (Morgan integration with Winston)
LOG_REQUESTS=true
LOG_REQUEST_FORMAT=combined
LOG_REQUEST_SKIP_SUCCESS=false

# Security and audit logging
LOG_SECURITY_EVENTS=true
LOG_AUTH_EVENTS=true
LOG_RATE_LIMIT_EVENTS=true
LOG_ERROR_DETAILS=true

# Application-specific logging
LOG_DATABASE_QUERIES=false
LOG_API_CALLS=true
LOG_PERFORMANCE_METRICS=true

# ============================================================================
# DATABASE CONFIGURATION (if applicable)
# ============================================================================

# Database connection settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSL=false

# Connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000

# ============================================================================
# EXTERNAL API CONFIGURATION
# ============================================================================

# Backprop integration (if using)
BACKPROP_API_KEY=your-backprop-api-key
BACKPROP_BASE_URL=https://api.backprop.co
BACKPROP_RATE_LIMIT=1000

# Other external API configurations
API_TIMEOUT=30000
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY=1000

# ============================================================================
# SECURITY FEATURE TOGGLES
# ============================================================================

# Core security features
HELMET_ENABLED=true
COMPRESSION_ENABLED=true
SECURITY_MIDDLEWARE_ENABLED=true

# Request parsing and limits
BODY_PARSER_LIMIT=10mb
URL_ENCODED_LIMIT=10mb
JSON_LIMIT=10mb
RAW_LIMIT=10mb
TEXT_LIMIT=10mb

# Additional security features
FAIL2BAN_ENABLED=false
FAIL2BAN_MAX_ATTEMPTS=5
FAIL2BAN_BAN_DURATION=3600000

# Security monitoring
SECURITY_AUDIT_ENABLED=true
VULNERABILITY_SCAN_ENABLED=false
INTRUSION_DETECTION_ENABLED=false

# ============================================================================
# PRODUCTION SECURITY SETTINGS
# ============================================================================

# Run as non-root user (production)
RUN_AS_USER=nodejs
RUN_AS_GROUP=nodejs

# Process management (PM2 Configuration)
PM2_ENABLED=true
PM2_INSTANCES=max
PM2_MAX_MEMORY_RESTART=512M
PM2_MIN_UPTIME=10s
PM2_MAX_RESTARTS=10
PM2_AUTORESTART=true
PM2_WATCH=false
PM2_IGNORE_WATCH=node_modules,logs,.git
PM2_EXEC_MODE=cluster
PM2_KILL_TIMEOUT=5000
PM2_LISTEN_TIMEOUT=3000
PM2_SHUTDOWN_WITH_MESSAGE=false
PM2_WAIT_READY=false
PM2_INSTANCE_VAR=INSTANCE_ID

# PM2 Plus/Enterprise monitoring
PM2_PUBLIC_KEY=
PM2_SECRET_KEY=
PM2_MACHINE_NAME=

# PM2 Log management
PM2_LOG_DATE_FORMAT=YYYY-MM-DD HH:mm:ss Z
PM2_ERROR_FILE=./logs/pm2-error.log
PM2_OUT_FILE=./logs/pm2-out.log
PM2_LOG_FILE=./logs/pm2.log
PM2_PID_FILE=./logs/pm2.pid

# Health check configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_TIMEOUT=5000

# ============================================================================
# DEVELOPMENT SETTINGS & OVERRIDES
# ============================================================================

# Development-specific settings (NEVER use in production)
DEV_MODE=true
DEV_CORS_ALLOW_ALL=false
DEV_DISABLE_AUTH=false
DEV_DISABLE_RATE_LIMITING=false
DEV_DISABLE_HTTPS_REDIRECT=true
DEV_DISABLE_HELMET=false

# Mock external services for development
DEV_MOCK_EXTERNAL_APIS=false
DEV_MOCK_BACKPROP_API=false
DEV_MOCK_DATABASE=false
DEV_MOCK_EMAIL_SERVICE=false

# Hot reload and file watching
HOT_RELOAD=true
WATCH_FILES=true
WATCH_EXTENSIONS=js,json,ts
WATCH_IGNORE=node_modules,dist,build,logs,.git
NODEMON_DELAY=250ms
NODEMON_VERBOSE=false

# Development debugging configuration
DEBUG_ENABLED=false
DEBUG_NAMESPACE=app:*
DEBUG_COLORS=true
DEBUG_DEPTH=3
DEBUG_SHOW_HIDDEN=false
DEBUG_BREAK_LENGTH=80

# Development logging overrides
DEV_LOG_LEVEL=debug
DEV_LOG_COLORIZE=true
DEV_LOG_REQUESTS=true
DEV_LOG_SENSITIVE_DATA=true

# Development security relaxation (use carefully)
DEV_ALLOW_INSECURE_COOKIES=true
DEV_DISABLE_CSP=false
DEV_ALLOW_UNSAFE_INLINE=true

# Development API settings
DEV_API_TIMEOUT=60000
DEV_API_RETRY_ATTEMPTS=1
DEV_FAKE_SLOW_RESPONSES=false
DEV_FAKE_ERRORS=false

# Development database settings
DEV_DB_LOGGING=true
DEV_DB_SYNC=true
DEV_DB_FORCE_SYNC=false
DEV_SEED_DATA=true

# ============================================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# ============================================================================

# Uncomment and customize based on your environment:

# # STAGING ENVIRONMENT
# NODE_ENV=staging
# HTTPS_ENABLED=true
# RATE_LIMIT_MAX_REQUESTS=500
# LOG_LEVEL=warn
# LOG_SENSITIVE_DATA=false

# # PRODUCTION ENVIRONMENT
# NODE_ENV=production
# HTTPS_ENABLED=true
# TRUST_PROXY=true
# RATE_LIMIT_MAX_REQUESTS=2000
# SESSION_SECURE=true
# LOG_LEVEL=error
# LOG_SENSITIVE_DATA=false
# HSTS_ENABLED=true
# PM2_INSTANCES=4

# ============================================================================
# NOTES & SECURITY REMINDERS
# ============================================================================

# 1. ALWAYS use HTTPS in production (set HTTPS_ENABLED=true)
# 2. Change ALL default secrets before deployment
# 3. Use environment-specific .env files (.env.development, .env.production)
# 4. Never commit .env files to version control
# 5. Use strong, unique passwords and API keys
# 6. Regularly rotate JWT secrets and API keys
# 7. Monitor security logs for suspicious activities
# 8. Keep dependencies updated to patch security vulnerabilities
# 9. Use proper SSL/TLS certificates from a trusted CA in production
# 10. Configure CORS origins restrictively for production environments

# For more security guidance, refer to:
# - OWASP Node.js Security Cheat Sheet
# - Node.js Security Best Practices
# - Express.js Production Best Practices