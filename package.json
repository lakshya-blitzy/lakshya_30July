{
  "name": "secure-node-server",
  "version": "1.0.0",
  "description": "Secure Node.js HTTP server with comprehensive security middleware to address CVE-2024-45590 and CVE-2024-43796 vulnerabilities",
  "main": "server.js",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "pm2 start ecosystem.config.js --env production",
    "prod:stop": "pm2 stop ecosystem.config.js",
    "prod:restart": "pm2 restart ecosystem.config.js",
    "prod:reload": "pm2 reload ecosystem.config.js",
    "prod:logs": "pm2 logs",
    "prod:monitor": "pm2 monit",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "security:check": "npm audit --audit-level=high",
    "test": "jest",
    "test:mocha": "mocha test/**/*.test.js --timeout 10000",
    "test:all": "npm run test && npm run test:mocha",
    "test:coverage": "nyc --reporter=html --reporter=text jest && nyc --reporter=html --reporter=text mocha test/**/*.test.js",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.20.0",
    "express-rate-limit": "^7.1.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "pm2": "^5.0.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "autocannon": "^7.15.0",
    "chai": "^4.5.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "mocha": "^11.7.1",
    "nock": "^13.5.6",
    "nodemon": "^3.0.0",
    "nyc": "^15.1.0",
    "performance-now": "^2.1.0",
    "pg": "^8.16.3",
    "simple-statistics": "^7.8.8",
    "sinon": "^15.2.0",
    "supertest": "^7.1.4"
  },
  "keywords": [
    "nodejs",
    "express",
    "security",
    "helmet",
    "rate-limiting",
    "cors",
    "input-validation",
    "https",
    "owasp",
    "cve-2024-45590",
    "cve-2024-43796"
  ],
  "author": "Blitzy Platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/blitzy-public-samples/secure-node-server.git"
  },
  "bugs": {
    "url": "https://github.com/blitzy-public-samples/secure-node-server/issues"
  },
  "homepage": "https://github.com/blitzy-public-samples/secure-node-server#readme"
}
